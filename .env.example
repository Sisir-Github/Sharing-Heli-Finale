NODE_ENV="development"
DATABASE_URL="file:./sharing-heli.db"

NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://127.0.0.1:3000"
NEXT_PUBLIC_SITE_URL="http://127.0.0.1:3000"

PORT="3000"
HOSTNAME="127.0.0.1"

ADMIN_EMAIL=""
ADMIN_PASSWORD=""

SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your-gmail-address@gmail.com"
SMTP_PASS="your-google-app-password"
SMTP_FROM="Sharing Heli <your-gmail-address@gmail.com>"
INQUIRY_EMAIL="info@pokharaflightcentre.com"
# Optional override; defaults to the contact email configured in the admin panel.
RESERVATION_NOTIFICATION_EMAIL=""

# WhatsApp Business Cloud API. The approved template body must use these
# variables in order: customer name, booking reference, route, date, passengers.
# Suggested body: Hello {{1}}, we received request {{2}} for {{3}} on {{4}} for {{5}} passenger(s). This is not yet a confirmed flight.
WHATSAPP_GRAPH_API_VERSION=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_TEMPLATE_NAME="reservation_request_received"
WHATSAPP_TEMPLATE_LANGUAGE="en"

# Optional production integrations
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_BING_SITE_VERIFICATION=""
NEXT_PUBLIC_GA4_ID=""
INDEXNOW_KEY=""
INDEXNOW_KEY_LOCATION=""
