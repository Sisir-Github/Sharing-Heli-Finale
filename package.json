{
  "name": "sharing-heli-nepal",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "cpanel:start": "NODE_ENV=production node app.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:responsive": "node scripts/responsive-audit.mjs",
    "test:crawl": "node scripts/crawl-audit.mjs",
    "check:env": "node scripts/validate-env.mjs",
    "check:env:seed": "node scripts/validate-env.mjs --include-seed",
    "security:audit": "npm audit --omit=dev",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "prisma": "prisma",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "bcrypt": "^6.0.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "16.3.0",
    "next-auth": "4.24.15",
    "nodemailer": "9.0.5",
    "pdfkit": "^0.19.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "autoprefixer": "^10.4.20",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "playwright-core": "^1.62.1",
    "postcss": "^8.4.49",
    "prisma": "^5.20.0",
    "tailwindcss": "^3.4.16",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
